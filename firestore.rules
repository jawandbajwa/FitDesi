rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'jawandbajwa@gmail.com';
    }

    // Top-level user container docs — admin can list/read all, users read own
    match /users/{userId} {
      allow read:  if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // User subcollections (data/profile, logs, workouts, progress, etc.)
    // Admin can read/write any user's subcollections (assign coach, view stats)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // collectionGroup query on "data" — lets admin panel list ALL users' profiles
    // in one query via collectionGroup(db, "data") without needing top-level stubs.
    match /{path=**}/data/{document} {
      allow read: if isAdmin();
    }

    // Shared recipes and ingredients — anyone authenticated can read, only admin can write
    match /shared/{document=**} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin audit log — append-only by admin; readable only by admin.
    // Tracks every sensitive action (setAdminStatus, deleteRecipe,
    // deleteUserRecipe, promoteUserRecipe, deleteIngredient, assignCoach).
    // No update/delete allowed — preserves a tamper-evident history.
    match /audit/{document} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
