rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared data: authenticated users can read, only admin can write
    // Note: Admin check is done in code, but for security, we allow write for authenticated users
    // In production, consider using custom claims for admin
    match /shared/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}